">123</span><br><span class="line">124</span><br><span class="line">125</span><br><span class="line">126</span><br><span class="line">127</span><br><span class="line">128</span><br><span class="line">129</span><br><span class="line">130</span><br><span class="line">131</span><br><span class="line">132</span><br><span class="line">133</span><br><span class="line">134</span><br><span class="line">135</span><br><span class="line">136</span><br><span class="line">137</span><br><span class="line">138</span><br><span class="line">139</span><br><span class="line">140</span><br><span class="line">141</span><br><span class="line">142</span><br><span class="line">143</span><br><span class="line">144</span><br><span class="line">145</span><br><span class="line">146</span><br><span class="line">147</span><br><span class="line">148</span><br><span class="line">149</span><br><span class="line">150</span><br><span class="line">151</span><br><span class="line">152</span><br><span class="line">153</span><br><span class="line">154</span><br><span class="line">155</span><br><span class="line">156</span><br><span class="line">157</span><br><span class="line">158</span><br><span class="line">159</span><br><span class="line">160</span><br><span class="line">161</span><br><span class="line">162</span><br><span class="line">163</span><br><span class="line">164</span><br><span class="line">165</span><br><span class="line">166</span><br><span class="line">167</span><br><span class="line">168</span><br><span class="line">169</span><br><span class="line">170</span><br><span class="line">171</span><br><span class="line">172</span><br><span class="line">173</span><br><span class="line">174</span><br><span class="line">175</span><br><span class="line">176</span><br><span class="line">177</span><br><span class="line">178</span><br><span class="line">179</span><br><span class="line">180</span><br><span class="line">181</span><br><span class="line">182</span><br><span class="line">183</span><br><span class="line">184</span><br><span class="line">185</span><br><span class="line">186</span><br><span class="line">187</span><br><span class="line">188</span><br><span class="line">189</span><br><span class="line">190</span><br><span class="line">191</span><br><span class="line">192</span><br><span class="line">193</span><br><span class="line">194</span><br><span class="line">195</span><br><span class="line">196</span><br><span class="line">197</span><br><span class="line">198</span><br><span class="line">199</span><br><span class="line">200</span><br><span class="line">201</span><br><span class="line">202</span><br><span class="line">203</span><br><span class="line">204</span><br><span class="line">205</span><br><span class="line">206</span><br><span class="line">207</span><br><span class="line">208</span><br><span class="line">209</span><br><span class="line">210</span><br><span class="line">211</span><br><span class="line">212</span><br><span class="line">213</span><br><span class="line">214</span><br><span class="line">215</span><br><span class="line">216</span><br><span class="line">217</span><br><span class="line">218</span><br><span class="line">219</span><br><span class="line">220</span><br><span class="line">221</span><br><span class="line">222</span><br><span class="line">223</span><br><span class="line">224</span><br><span class="line">225</span><br><span class="line">226</span><br><span class="line">227</span><br><span class="line">228</span><br><span class="line">229</span><br><span class="line">230</span><br><span class="line">231</span><br><span class="line">232</span><br><span class="line">233</span><br><span class="line">234</span><br><span class="line">235</span><br><span class="line">236</span><br><span class="line">237</span><br><span class="line">238</span><br><span class="line">239</span><br><span class="line">240</span><br><span class="line">241</span><br><span class="line">242</span><br><span class="line">243</span><br><span class="line">244</span><br><span class="line">245</span><br><span class="line">246</span><br><span class="line">247</span><br><span class="line">248</span><br><span class="line">249</span><br><span class="line">250</span><br><span class="line">251</span><br><span class="line">252</span><br><span class="line">253</span><br><span class="line">254</span><br><span class="line">255</span><br><span class="line">256</span><br><span class="line">257</span><br><span class="line">258</span><br><span class="line">259</span><br><span class="line">260</span><br><span class="line">261</span><br><span class="line">262</span><br><span class="line">263</span><br><span class="line">264</span><br></pre></td><td class="code"><pre><span class="line"><span class="meta">#<span class="keyword">include</span><span class="string">&lt;bits/stdc++.h&gt;</span></span></span><br><span class="line"><span class="keyword">using</span> <span class="keyword">namespace</span> std;</span><br><span class="line"></span><br><span class="line"><span class="comment">// 定义数组和变量</span></span><br><span class="line"><span class="type">int</span> a[<span class="number">100001</span>], n; <span class="comment">// a数组用于存储待排序的元素，n表示元素个数</span></span><br><span class="line"><span class="type">const</span> <span class="type">int</span> N = <span class="number">1e5</span>; <span class="comment">// 常量N用于定义数组大小</span></span><br><span class="line"><span class="type">int</span> cnt[N], b[<span class="number">100001</span>]; <span class="comment">// cnt数组用于计数排序，b数组用于临时存储排序结果</span></span><br><span class="line"><span class="type">int</span> minn = <span class="number">0x3f3f3f3f</span>, maxn = <span class="number">0</span>; <span class="comment">// minn和maxn用于存储数组中的最小值和最大值</span></span><br><span class="line">vector&lt;<span class="type">int</span>&gt; tmp; <span class="comment">// tmp向量用于临时存储归并排序中的中间结果</span></span><br><span class="line"></span><br><span class="line"><span class="comment">// 选择排序</span></span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">selection_sort</span><span class="params">()</span> </span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i = <span class="number">1</span>; i &lt; n; i++) <span class="comment">// 遍历数组，每次选择最小的元素放到合适的位置</span></span><br><span class="line">    &#123;</span><br><span class="line">        <span class="type">int</span> ith = i; <span class="comment">// 记录当前最小元素的位置</span></span><br><span class="line">        <span class="keyword">for</span>(<span class="type">int</span> j = i + <span class="number">1</span>; j &lt;= n; j++) <span class="comment">// 在未排序部分寻找最小元素</span></span><br><span class="line">        &#123;</span><br><span class="line">            <span class="keyword">if</span>(a[ith] &gt; a[j]) ith = j; <span class="comment">// 更新最小元素的位置</span></span><br><span class="line">        &#125; </span><br><span class="line">        <span class="built_in">swap</span>(a[i], a[ith]); <span class="comment">// 将找到的最小元素与当前元素交换</span></span><br><span class="line">    &#125;</span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="comment">// 冒泡排序</span></span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">bubble_sort</span><span class="params">()</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="type">bool</span> flag = <span class="literal">true</span>; <span class="comment">// 标志位，用于检测是否发生交换</span></span><br><span class="line">    <span class="keyword">while</span>(flag)</span><br><span class="line">    &#123;</span><br><span class="line">        flag = <span class="literal">false</span>; <span class="comment">// 假设本次循环没有发生交换</span></span><br><span class="line">        <span class="keyword">for</span>(<span class="type">int</span> i = <span class="number">1</span>; i &lt; n; i++) <span class="comment">// 遍历数组</span></span><br><span class="line">        &#123;</span><br><span class="line">            <span class="keyword">if</span>(a[i] &gt; a[i + <span class="number">1</span>]) <span class="comment">// 如果前一个元素大于后一个元素</span></span><br><span class="line">            &#123;</span><br><span class="line">                flag = <span class="literal">true</span>; <span class="comment">// 发生交换，标志位置为true</span></span><br><span class="line">                <span class="built_in">swap</span>(a[i], a[i + <span class="number">1</span>]); <span class="comment">// 交换两个元素</span></span><br><span class="line">            &#125;</span><br><span class="line">        &#125;</span><br><span class="line">    &#125;</span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="comment">// 插入排序</span></span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">Insertion_sort</span><span class="params">()</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i = <span class="number">2</span>; i &lt;= n; i++) <span class="comment">// 从第二个元素开始遍历</span></span><br><span class="line">    &#123;</span><br><span class="line">        <span class="type">int</span> j = i - <span class="number">1</span>, t = a[i]; <span class="comment">// j指向当前元素的前一个位置，t存储当前元素的值</span></span><br><span class="line">        <span class="comment">// 将当前元素插入到已排序部分的合适位置</span></span><br><span class="line">		<span class="keyword">while</span>(j&gt;<span class="number">0</span>&amp;&amp;a[j]&gt;<span class="comment">/*a[i]*/</span>t) <span class="comment">//a[i]会变 </span></span><br><span class="line">        &#123;</span><br><span class="line">            a[j + <span class="number">1</span>] = a[j]; <span class="comment">// 向后移动元素</span></span><br><span class="line">            j--; <span class="comment">// 向前移动指针</span></span><br><span class="line">        &#125;</span><br><span class="line">        a[j + <span class="number">1</span>] = t; <span class="comment">// 插入当前元素到合适位置</span></span><br><span class="line">    &#125;</span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="comment">// 计数排序</span></span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">Counting_sort</span><span class="params">()</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="built_in">memset</span>(b, <span class="number">0</span>, <span class="keyword">sizeof</span>(b)); <span class="comment">// 初始化b数组为0</span></span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i = <span class="number">1</span>; i &lt;= n; i++) </span><br><span class="line">    &#123;</span><br><span class="line">        minn = <span class="built_in">min</span>(a[i], minn); <span class="comment">// 更新最小值</span></span><br><span class="line">        maxn = <span class="built_in">max</span>(a[i], maxn); <span class="comment">// 更新最大值</span></span><br><span class="line">        cnt[a[i]]++; <span class="comment">// 统计每个元素出现的次数</span></span><br><span class="line">    &#125;</span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i = minn + <span class="number">1</span>; i &lt;= maxn; i++) cnt[i] += cnt[i - <span class="number">1</span>]; <span class="comment">// 计算累积计数</span></span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i = n; i &gt;= <span class="number">1</span>; i--) b[cnt[a[i]]--] = a[i]; <span class="comment">// 根据累积计数将元素放入b数组</span></span><br><span class="line">    <span class="built_in">memcpy</span>(a, b, <span class="keyword">sizeof</span>(b)); <span class="comment">// 将b数组复制回a数组</span></span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="comment">// 基数排序</span></span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">radix_sort</span><span class="params">()</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i = <span class="number">1</span>; i &lt;= n; i++) maxn = <span class="built_in">max</span>(a[i], maxn); <span class="comment">// 找到最大值</span></span><br><span class="line">    <span class="type">int</span> digit = <span class="number">0</span>; <span class="comment">// 记录最大值的位数</span></span><br><span class="line">    <span class="keyword">while</span>(maxn)</span><br><span class="line">    &#123;</span><br><span class="line">        maxn /= <span class="number">10</span>; <span class="comment">// 计算位数</span></span><br><span class="line">        digit++;</span><br><span class="line">    &#125;</span><br><span class="line">    <span class="type">int</span> base = <span class="number">1</span>; <span class="comment">// 基数</span></span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i = <span class="number">1</span>; i &lt;= digit; i++) <span class="comment">//共digit位，每一位进行计数排序 </span></span><br><span class="line">    &#123;</span><br><span class="line">        <span class="built_in">memset</span>(cnt, <span class="number">0</span>, <span class="keyword">sizeof</span>(cnt)); <span class="comment">// 初始化计数数组</span></span><br><span class="line">        <span class="keyword">for</span>(<span class="type">int</span> i = <span class="number">1</span>; i &lt;= n; i++) cnt[(a[i] / base) % <span class="number">10</span>]++; <span class="comment">// 统计每个位上的数字出现次数</span></span><br><span class="line">        <span class="keyword">for</span>(<span class="type">int</span> i = <span class="number">1</span>; i &lt; <span class="number">10</span>; i++) cnt[i] += cnt[i - <span class="number">1</span>]; <span class="comment">// 计算累积计数</span></span><br><span class="line">        <span class="keyword">for</span>(<span class="type">int</span> i = n; i &gt;= <span class="number">1</span>; i--) b[cnt[(a[i] / base) % <span class="number">10</span>]--] = a[i]; <span class="comment">// 根据累积计数将元素放入b数组</span></span><br><span class="line">        <span class="built_in">memcpy</span>(a, b, <span class="keyword">sizeof</span>(b)); <span class="comment">// 将b数组复制回a数组</span></span><br><span class="line">        base *= <span class="number">10</span>; <span class="comment">// 基数乘以10</span></span><br><span class="line">    &#125;</span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line">vector&lt;<span class="type">int</span>&gt; bucket[N];</span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">bucket_sort</span><span class="params">()</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i=<span class="number">1</span>;i&lt;=n;i++)</span><br><span class="line">    &#123;</span><br><span class="line">        maxn=<span class="built_in">max</span>(a[i],maxn);</span><br><span class="line">        minn=<span class="built_in">min</span>(a[i],minn);</span><br><span class="line">    &#125;</span><br><span class="line">    <span class="type">int</span> size=(maxn-minn)/n<span class="number">+1</span>;<span class="comment">//+1:保证桶可装 /n：尽量均匀</span></span><br><span class="line">    <span class="type">int</span> cnt=(maxn-minn)/size<span class="number">+1</span>;<span class="comment">//+1:保证有桶</span></span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i=<span class="number">1</span>;i&lt;=n;i++) bucket[(a[i]-minn)/size].<span class="built_in">push_back</span>(a[i]);</span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i=<span class="number">0</span>;i&lt;cnt;i++) </span><br><span class="line">    &#123;</span><br><span class="line">        <span class="built_in">sort</span>(bucket[i].<span class="built_in">begin</span>(),bucket[i].<span class="built_in">end</span>());</span><br><span class="line">        <span class="keyword">for</span>(<span class="type">int</span> v:bucket[i]) cout&lt;&lt;v&lt;&lt;<span class="string">&#x27; &#x27;</span>;</span><br><span class="line">    &#125;</span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="comment">// 快速排序的三种分区方法 内部局部排序</span></span><br><span class="line"><span class="function"><span class="type">int</span> <span class="title">hoare_sort</span><span class="params">(<span class="type">int</span> l, <span class="type">int</span> r)</span> <span class="comment">// 左右指针法</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="type">int</span> key = l; <span class="comment">// 选择第一个元素作为基准</span></span><br><span class="line">    <span class="type">int</span> base = a[key]; <span class="comment">// 基准值</span></span><br><span class="line">    <span class="keyword">while</span>(l &lt; r)</span><br><span class="line">    &#123;</span><br><span class="line">        <span class="keyword">while</span>(l &lt; r &amp;&amp; a[r] &gt;= base) r--; <span class="comment">// 从右向左找到第一个小于基准的元素</span></span><br><span class="line">        <span class="keyword">while</span>(l &lt; r &amp;&amp; a[l] &lt;= base) l++; <span class="comment">// 从左向右找到第一个大于基准的元素</span></span><br><span class="line">        <span class="built_in">swap</span>(a[l], a[r]); <span class="comment">// 交换这两个元素</span></span><br><span class="line">    &#125; </span><br><span class="line">    <span class="built_in">swap</span>(a[l], a[key]); <span class="comment">// 将基准元素放到合适位置</span></span><br><span class="line">    <span class="keyword">return</span> l; <span class="comment">// 返回基准位置</span></span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="function"><span class="type">int</span> <span class="title">hole_sort</span><span class="params">(<span class="type">int</span> l, <span class="type">int</span> r)</span> <span class="comment">// 挖坑法</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="type">int</span> base = a[l]; <span class="comment">// 选择第一个元素作为基准</span></span><br><span class="line">    <span class="keyword">while</span>(l &lt; r)</span><br><span class="line">    &#123;</span><br><span class="line">        <span class="keyword">while</span>(l &lt; r &amp;&amp; a[r] &gt;= base) r--; <span class="comment">// 从右向左找到第一个小于基准的元素</span></span><br><span class="line">        a[l] = a[r]; <span class="comment">// 将该元素填入左边的坑</span></span><br><span class="line">        <span class="keyword">while</span>(l &lt; r &amp;&amp; a[l] &lt;= base) l++; <span class="comment">// 从左向右找到第一个大于基准的元素</span></span><br><span class="line">        a[r] = a[l]; <span class="comment">// 将该元素填入右边的坑</span></span><br><span class="line">    &#125;</span><br><span class="line">    a[l] = base; <span class="comment">// 将基准元素放到合适位置</span></span><br><span class="line">    <span class="keyword">return</span> l; <span class="comment">// 返回基准位置</span></span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="function"><span class="type">int</span> <span class="title">qh_sort</span><span class="params">(<span class="type">int</span> l, <span class="type">int</span> r)</span> <span class="comment">// 前后指针法</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="type">int</span> base = a[l]; <span class="comment">// 选择第一个元素作为基准</span></span><br><span class="line">    <span class="type">int</span> prev = l, cur = l + <span class="number">1</span>; <span class="comment">// 前后指针</span></span><br><span class="line">    <span class="keyword">while</span>(cur &lt;= r)</span><br><span class="line">    &#123;</span><br><span class="line">        <span class="keyword">while</span>(a[cur] &lt;= base &amp;&amp; ++prev != cur) <span class="built_in">swap</span>(a[prev], a[cur]); <span class="comment">// 如果当前元素小于等于基准，且前后指针不重合，交换</span></span><br><span class="line">        cur++; <span class="comment">// 后指针右移</span></span><br><span class="line">    &#125;</span><br><span class="line">    <span class="built_in">swap</span>(a[prev], a[l]); <span class="comment">// 将基准元素放到合适位置</span></span><br><span class="line">    <span class="keyword">return</span> prev; <span class="comment">// 返回基准位置</span></span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">tridiv_sort</span><span class="params">(<span class="type">int</span> &amp;l, <span class="type">int</span> &amp;r)</span> <span class="comment">// 三路划分</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="type">int</span> base = a[l]; <span class="comment">// 选择第一个元素作为基准</span></span><br><span class="line">    <span class="type">int</span> cur = l + <span class="number">1</span>; <span class="comment">// 当前指针</span></span><br><span class="line">    <span class="keyword">while</span>(cur &lt;= r)</span><br><span class="line">    &#123;</span><br><span class="line">        <span class="keyword">if</span>(a[cur] &lt; base) <span class="built_in">swap</span>(a[l++], a[cur++]); <span class="comment">// 如果当前元素小于基准，交换到左边</span></span><br><span class="line">        <span class="comment">// 如果当前元素大于基准，交换到右边</span></span><br><span class="line">		<span class="keyword">else</span> <span class="keyword">if</span>(a[cur] &gt; base) <span class="built_in">swap</span>(a[r--], a[cur]); <span class="comment">//cur不++:原来的a[r]未处理,不跳过</span></span><br><span class="line">        <span class="keyword">else</span> cur++; <span class="comment">// 如果当前元素等于基准，指针右移</span></span><br><span class="line">    &#125;</span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="comment">// 快速排序</span></span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">quick_sort</span><span class="params">(<span class="type">int</span> l, <span class="type">int</span> r)</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="keyword">if</span>(l &gt;= r) <span class="keyword">return</span>; <span class="comment">// 如果区间长度为0或负，返回</span></span><br><span class="line">    <span class="comment">/*int key=qh_sort(l,r);等三种内部局部排序函数</span></span><br><span class="line"><span class="comment">    quick_sort(l,key-1);</span></span><br><span class="line"><span class="comment">    quick_sort(key+1,r);*/</span></span><br><span class="line">    <span class="type">int</span> L = l, R = r; <span class="comment">// 保存初始区间</span></span><br><span class="line">    <span class="built_in">tridiv_sort</span>(l, r); <span class="comment">// 三路划分</span></span><br><span class="line">    <span class="built_in">quick_sort</span>(L, l - <span class="number">1</span>); <span class="comment">// 递归排序左区间</span></span><br><span class="line">    <span class="built_in">quick_sort</span>(r + <span class="number">1</span>, R); <span class="comment">// 递归排序右区间</span></span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="comment">// 归并排序</span></span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">merge_sort</span><span class="params">(<span class="type">int</span> l, <span class="type">int</span> r)</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="keyword">if</span>(l == r) <span class="keyword">return</span>; <span class="comment">// 如果区间长度为1，返回</span></span><br><span class="line">    <span class="type">int</span> mid = l + ((r - l) &gt;&gt; <span class="number">1</span>); <span class="comment">// 计算中点</span></span><br><span class="line">    <span class="built_in">merge_sort</span>(l, mid); <span class="comment">// 递归排序左区间</span></span><br><span class="line">    <span class="built_in">merge_sort</span>(mid + <span class="number">1</span>, r); <span class="comment">// 递归排序右区间</span></span><br><span class="line">    tmp.<span class="built_in">clear</span>(); <span class="comment">// 清空临时向量</span></span><br><span class="line">    <span class="type">int</span> i = l, j = mid + <span class="number">1</span>; <span class="comment">// 左右指针</span></span><br><span class="line">    <span class="keyword">while</span>(i &lt;= mid &amp;&amp; j &lt;= r) <span class="comment">// 合并两个有序区间</span></span><br><span class="line">    &#123;</span><br><span class="line">        <span class="keyword">if</span>(a[i] &gt; a[j]) tmp.<span class="built_in">push_back</span>(a[j++]); <span class="comment">// 如果左区间元素大于右区间元素，将右区间元素放入临时向量</span></span><br><span class="line">        <span class="keyword">else</span> tmp.<span class="built_in">push_back</span>(a[i++]); <span class="comment">// 否则将左区间元素放入临时向量</span></span><br><span class="line">    &#125;</span><br><span class="line">    <span class="keyword">while</span>(i &lt;= mid) tmp.<span class="built_in">push_back</span>(a[i++]); <span class="comment">// 将剩余左区间元素放入临时向量</span></span><br><span class="line">    <span class="keyword">while</span>(j &lt;= r) tmp.<span class="built_in">push_back</span>(a[j++]); <span class="comment">// 将剩余右区间元素放入临时向量</span></span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> k = l; k &lt;= r; k++) a[k] = tmp[k - l]; <span class="comment">// 将临时向量中的元素复制回原数组</span></span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="comment">// 堆排序</span></span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">shift</span><span class="params">(<span class="type">int</span> p, <span class="type">int</span> end)</span> <span class="comment">// 调整堆</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="keyword">while</span>((p &lt;&lt; <span class="number">1</span>) &lt;= end) <span class="comment">// 如果有左孩子</span></span><br><span class="line">    &#123;</span><br><span class="line">        <span class="type">int</span> lc = p &lt;&lt; <span class="number">1</span>; <span class="comment">// 左孩子</span></span><br><span class="line">        <span class="type">int</span> rc = p &lt;&lt; <span class="number">1</span> | <span class="number">1</span>; <span class="comment">// 右孩子</span></span><br><span class="line">        <span class="keyword">if</span>(a[lc] &lt; a[rc] &amp;&amp; rc &lt;= end) lc = rc; <span class="comment">// 如果右孩子存在且大于左孩子，选择右孩子</span></span><br><span class="line">        <span class="keyword">if</span>(a[p] &lt; a[lc]) <span class="built_in">swap</span>(a[lc], a[p]); <span class="comment">// 如果父节点小于孩子节点，交换</span></span><br><span class="line">        <span class="keyword">else</span> <span class="keyword">break</span>; <span class="comment">// 否则调整结束</span></span><br><span class="line">        p = lc; <span class="comment">// 继续向下调整</span></span><br><span class="line">    &#125;</span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">heap_sort</span><span class="params">()</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i = n / <span class="number">2</span>; i; i--) <span class="built_in">shift</span>(i, n); <span class="comment">// 构建大顶堆</span></span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i = n; i; i--) <span class="comment">// 排序</span></span><br><span class="line">    &#123;</span><br><span class="line">        <span class="built_in">swap</span>(a[<span class="number">1</span>], a[i]); <span class="comment">// 将堆顶元素与最后一个元素交换</span></span><br><span class="line">        <span class="built_in">shift</span>(<span class="number">1</span>, i - <span class="number">1</span>); <span class="comment">// 调整堆</span></span><br><span class="line">    &#125;</span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="comment">// 希尔排序</span></span><br><span class="line"><span class="function"><span class="type">void</span> <span class="title">shell_sort</span><span class="params">()</span></span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    <span class="type">int</span> gap = n; <span class="comment">// 初始间隔</span></span><br><span class="line">    <span class="keyword">while</span>(gap)</span><br><span class="line">    &#123;</span><br><span class="line">        gap /= <span class="number">2</span>; <span class="comment">// 间隔减半</span></span><br><span class="line">        <span class="keyword">for</span>(<span class="type">int</span> i = gap + <span class="number">1</span>; i &lt;= n; i++) <span class="comment">// 对每个间隔进行插入排序</span></span><br><span class="line">        &#123;</span><br><span class="line">            <span class="type">int</span> t = a[i], j = i - gap; <span class="comment">// 当前元素和前一个间隔元素</span></span><br><span class="line">            <span class="keyword">while</span>(j &gt;= <span class="number">1</span> &amp;&amp; a[j] &gt; t) <span class="comment">// 插入排序</span></span><br><span class="line">            &#123;</span><br><span class="line">                a[j + gap] = a[j]; <span class="comment">// 向后移动元素</span></span><br><span class="line">                j -= gap; <span class="comment">// 向前移动指针</span></span><br><span class="line">            &#125;</span><br><span class="line">            a[j + gap] = t; <span class="comment">// 插入当前元素到合适位置</span></span><br><span class="line">        &#125;</span><br><span class="line">    &#125;</span><br><span class="line">&#125;</span><br><span class="line"></span><br><span class="line"><span class="function"><span class="type">int</span> <span class="title">main</span><span class="params">()</span>	</span></span><br><span class="line"><span class="function"></span>&#123;</span><br><span class="line">    ios::<span class="built_in">sync_with_stdio</span>(<span class="number">0</span>); <span class="comment">// 关闭同步流</span></span><br><span class="line">    cin.<span class="built_in">tie</span>(<span class="number">0</span>); cout.<span class="built_in">tie</span>(<span class="number">0</span>); <span class="comment">// 解绑输入输出流</span></span><br><span class="line">    cin &gt;&gt; n; <span class="comment">// 输入元素个数</span></span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i = <span class="number">1</span>; i &lt;= n; i++) cin &gt;&gt; a[i]; <span class="comment">// 输入元素</span></span><br><span class="line">    <span class="comment">//selection_sort();</span></span><br><span class="line">    <span class="comment">//bubble_sort();</span></span><br><span class="line">    <span class="comment">//Insertion_sort();</span></span><br><span class="line">    <span class="comment">//Counting_sort();</span></span><br><span class="line">    <span class="comment">//radix_sort();</span></span><br><span class="line">    <span class="comment">//quick_sort(1,n);</span></span><br><span class="line">    <span class="comment">//merge_sort(1,n);</span></span><br><span class="line">    <span class="comment">//bucket_sort();</span></span><br><span class="line">    <span class="comment">//heap_sort();</span></span><br><span class="line">    <span class="comment">//shell_sort();</span></span><br><span class="line">    <span class="keyword">for</span>(<span class="type">int</span> i = <span class="number">1</span>; i &lt;= n; i++) cout &lt;&lt; a[i] &lt;&lt; <span class="string">&#x27; &#x27;</span>; <span class="comment">// 输出排序结果</span></span><br><span class="line">    <span class="keyword">return</span> <span class="number">0</span>;</span><br><span class="line">&#125;</span><br><span class="line"></span><br></pre></td></tr></table></figure>]]>
